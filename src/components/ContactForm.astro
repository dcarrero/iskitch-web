---
// Formulario de contacto de la web (/press y /support). Envía JSON a
// `endpoint`, que lo guarda en KV y avisa por correo a hello@ (ver
// functions-lib/contact.js). Los campos llegan por props, así que cada página
// decide cuáles pide; nombre y correo van siempre.
type Field = {
  name: string; label: string; hint?: string;
  type?: "text" | "textarea"; required?: boolean;
  maxlength?: number; autocomplete?: string; inputmode?: string;
};
interface Props {
  endpoint: string;
  fields: Field[];
  s: {
    name: string; email: string;
    consent: string; submit: string; sending: string; success: string; error: string;
  };
}
const { endpoint, fields, s } = Astro.props as Props;
const all: Field[] = [
  { name: "name", label: s.name, required: true, maxlength: 120, autocomplete: "name" },
  { name: "email", label: s.email, required: true, maxlength: 200, autocomplete: "email" },
  ...fields,
];
---
<form class="contact-form" data-endpoint={endpoint} data-sending={s.sending} data-success={s.success} data-error={s.error} novalidate>
  {all.map((f) => (
    <div class="cf-row">
      <label for={`cf-${f.name}`}>{f.label}</label>
      {f.type === "textarea"
        ? <textarea id={`cf-${f.name}`} name={f.name} rows="6" maxlength={f.maxlength ?? 3000} required={f.required} aria-describedby={f.hint ? `cf-${f.name}-hint` : undefined}></textarea>
        : <input id={`cf-${f.name}`} name={f.name} type={f.name === "email" ? "email" : "text"} required={f.required} maxlength={f.maxlength ?? 300} autocomplete={f.autocomplete} inputmode={f.inputmode} aria-describedby={f.hint ? `cf-${f.name}-hint` : undefined} />}
      {f.hint && <p class="cf-hint" id={`cf-${f.name}-hint`}>{f.hint}</p>}
    </div>
  ))}
  <input type="text" name="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" class="cf-hp" />
  <label class="cf-consent">
    <input type="checkbox" name="consent" required />
    <span set:html={s.consent}></span>
  </label>
  <button type="submit" class="btn btn-primary btn-lg">{s.submit}</button>
  <p class="cf-status" role="status" aria-live="polite"></p>
</form>

<script is:inline>
  document.querySelectorAll('form.contact-form').forEach((form) => {
    const status = form.querySelector('.cf-status');
    const submit = form.querySelector('button[type="submit"]');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Validación del navegador: marca el primer campo que falte.
      const bad = Array.from(form.querySelectorAll('input[required], textarea[required]')).find((el) => !el.checkValidity());
      if (bad) { bad.reportValidity(); bad.focus(); return; }
      const payload = { lang: document.documentElement.lang || 'en', consent: true };
      form.querySelectorAll('input[name], textarea[name]').forEach((el) => {
        if (el.name !== 'consent') payload[el.name] = el.value;
      });
      submit.disabled = true;
      status.textContent = form.dataset.sending;
      status.className = 'cf-status pending';
      try {
        const resp = await fetch(form.dataset.endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const json = await resp.json().catch(() => ({}));
        if (resp.ok && json.ok) {
          status.textContent = form.dataset.success;
          status.className = 'cf-status ok';
          form.reset();
        } else {
          status.textContent = form.dataset.error;
          status.className = 'cf-status err';
        }
      } catch (_) {
        status.textContent = form.dataset.error;
        status.className = 'cf-status err';
      } finally {
        submit.disabled = false;
      }
    });
  });
</script>

<style>
  .contact-form { display: flex; flex-direction: column; gap: 18px; margin: 28px 0 8px; padding: 24px; border: 1px solid var(--line-strong); border-radius: 14px; background: var(--paper); }
  .cf-row { display: flex; flex-direction: column; gap: 6px; }
  .cf-row label { font-weight: 600; font-size: 14px; color: var(--ink-1); }
  .cf-row input, .cf-row textarea {
    font: inherit; font-size: 15px; color: var(--ink-1); background: var(--paper);
    border: 1px solid var(--line-strong); border-radius: 10px; padding: 10px 12px; width: 100%; box-sizing: border-box;
  }
  .cf-row textarea { resize: vertical; min-height: 110px; }
  .cf-row input:focus-visible, .cf-row textarea:focus-visible { outline: 2px solid var(--brand-3); outline-offset: 1px; border-color: var(--brand-3); }
  .contact-form .cf-hint { margin: 0; font-size: 13px; color: var(--ink-3); line-height: 1.5; }
  .cf-hp { position: absolute; left: -9999px; opacity: 0; pointer-events: none; }
  .cf-consent { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: var(--ink-2); line-height: 1.5; }
  .cf-consent input { margin: 3px 0 0; width: 16px; height: 16px; accent-color: var(--brand-3); flex: 0 0 auto; }
  .contact-form .btn { align-self: flex-start; color: var(--paper); text-decoration: none; }
  .contact-form .btn:disabled { opacity: .55; cursor: not-allowed; }
  .contact-form .cf-status { margin: 0; min-height: 1.4em; font-size: 14px; font-weight: 600; }
  .contact-form .cf-status.ok { color: var(--green-ink); }
  .contact-form .cf-status.err { color: var(--brand-3); }
  .contact-form .cf-status.pending { color: var(--ink-2); font-weight: 500; }
  @media (max-width: 560px) {
    .contact-form { padding: 18px; }
    .contact-form .btn { align-self: stretch; justify-content: center; }
  }
</style>
